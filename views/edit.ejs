<div class="row">
    <div class="col-md-8 mx-auto">
        <h1>✏️ Редагувати студента</h1>
        <hr>

        <!-- Показуємо помилки валідації (якщо є) -->
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
            <div class="alert alert-danger">
                <h5>⚠️ Помилки валідації:</h5>
                <ul class="mb-0">
                    <% errors.forEach(function(error) { %>
                        <li><%= error.msg %></li>
                    <% }); %>
                </ul>
            </div>
        <% } %>

        <!-- Форма (така ж як create, тільки action інший) -->
        <form method="POST" action="/students/<%= student.id %>/edit" id="studentForm" novalidate>
            
            <!-- Ім'я -->
            <div class="mb-3">
                <label for="firstName" class="form-label">Ім'я <span class="text-danger">*</span></label>
                <input 
                    type="text" 
                    class="form-control" 
                    id="firstName" 
                    name="firstName"
                    value="<%= student.firstName %>"
                    required
                    minlength="2"
                    maxlength="50"
                    pattern="[А-Яа-яЁёІіЇїЄєҐґ\s\-]+"
                >
                <div class="invalid-feedback">
                    Ім'я має містити від 2 до 50 символів (тільки українські літери)
                </div>
                <div class="valid-feedback">
                    Виглядає добре! ✓
                </div>
            </div>

            <!-- Прізвище -->
            <div class="mb-3">
                <label for="lastName" class="form-label">Прізвище <span class="text-danger">*</span></label>
                <input 
                    type="text" 
                    class="form-control" 
                    id="lastName" 
                    name="lastName"
                    value="<%= student.lastName %>"
                    required
                    minlength="2"
                    maxlength="50"
                    pattern="[А-Яа-яЁёІіЇїЄєҐґ\s\-]+"
                >
                <div class="invalid-feedback">
                    Прізвище має містити від 2 до 50 символів (тільки українські літери)
                </div>
                <div class="valid-feedback">
                    Виглядає добре! ✓
                </div>
            </div>

            <!-- Вік -->
            <div class="mb-3">
                <label for="age" class="form-label">Вік <span class="text-danger">*</span></label>
                <input 
                    type="number" 
                    class="form-control" 
                    id="age" 
                    name="age"
                    value="<%= student.age %>"
                    required
                    min="16"
                    max="100"
                >
                <div class="invalid-feedback">
                    Вік має бути від 16 до 100 років
                </div>
                <div class="valid-feedback">
                    Виглядає добре! ✓
                </div>
            </div>

            <!-- Курс -->
            <div class="mb-3">
                <label for="course" class="form-label">Курс <span class="text-danger">*</span></label>
                <select class="form-select" id="course" name="course" required>
                    <option value="1" <%= student.course == 1 ? 'selected' : '' %>>1 курс</option>
                    <option value="2" <%= student.course == 2 ? 'selected' : '' %>>2 курс</option>
                    <option value="3" <%= student.course == 3 ? 'selected' : '' %>>3 курс</option>
                    <option value="4" <%= student.course == 4 ? 'selected' : '' %>>4 курс</option>
                </select>
                <div class="invalid-feedback">
                    Будь ласка, оберіть курс
                </div>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                <input 
                    type="email" 
                    class="form-control" 
                    id="email" 
                    name="email"
                    value="<%= student.email %>"
                    required
                    pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
                >
                <div class="invalid-feedback">
                    Введіть коректний email
                </div>
            </div>

            <!-- Телефон -->
            <div class="mb-3">
                <label for="phone" class="form-label">Телефон (необов'язково)</label>
                <input 
                    type="tel" 
                    class="form-control" 
                    id="phone" 
                    name="phone"
                    value="<%= student.phone || '' %>"
                    placeholder="+380XXXXXXXXX"
                    pattern="^\+380\d{9}$"
                >
                <div class="invalid-feedback">
                    Формат: +380XXXXXXXXX
                </div>
                <small class="form-text text-muted">Формат: +380XXXXXXXXX</small>
            </div>

            <!-- Кнопки -->
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    💾 Оновити
                </button>
                <a href="/students" class="btn btn-secondary">
                    ❌ Скасувати
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Клієнтська валідація -->
<script src="/js/validation.js"></script>